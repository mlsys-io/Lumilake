    {
      "parameters": {
        "promptType": "define",
        "text": "=Branch A (map/debate): create a data-first diffusion prompt from the digest.\n\nDigest:\n{{ $('News Digest') }}\n\nGoal: maximize factual anchoring, chart-like structure, and decision-useful signals.\n\nReturn exactly:\n- Positive Prompt: ...\n- Negative Prompt: ...\n- Must-Include Facts: 4 bullets\n- Debate Claim: 2 bullets on why this approach is stronger than a narrative-first layout",
        "messages": {
          "messageValues": [
            {
              "message": "You are Prompt Mapper A. Argue for data density, factual grounding, and explicit information hierarchy."
            }
          ]
