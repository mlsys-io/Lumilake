    {
      "parameters": {
        "promptType": "define",
        "text": "=Summarize one retrieved article for {{ $('News Retrieval - SQL').item.symbol }} in 3 compact bullets.\nTitle: {{ $('News Retrieval - SQL').item.title }}\nPublished: {{ $('News Retrieval - SQL').item.publishedDate }}\nCategory: {{ $('News Retrieval - SQL').item.category }}\nMetadata summary: {{ $('News Retrieval - SQL').item.summary }}\nArtifact: {{ $('News Retrieval - S3') }}",
