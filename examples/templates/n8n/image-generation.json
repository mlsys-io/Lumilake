    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH scoped_news AS (\n  SELECT\n    symbol,\n    id,\n    title,\n    \"publishedDate\",\n    publisher,\n    source,\n    category,\n    path,\n    COALESCE(summary, text, headline) AS synopsis\n  FROM demo.news_metadata\n  WHERE symbol = '{{ $('Stock') }}'\n    AND \"publishedDate\" IS NOT NULL\n    AND path IS NOT NULL\n    AND path <> ''\n),\nranked AS (\n  SELECT\n    *,\n    ROW_NUMBER() OVER (\n      PARTITION BY COALESCE(NULLIF(category, ''), 'uncategorized')\n      ORDER BY \"publishedDate\"::timestamp DESC, id\n    ) AS category_rank,\n    ROW_NUMBER() OVER (\n      ORDER BY \"publishedDate\"::timestamp DESC, id\n    ) AS recency_rank\n  FROM scoped_news\n)\nSELECT\n  symbol,\n  id,\n  title,\n  \"publishedDate\",\n  publisher,\n  source,\n  category,\n  path,\n  synopsis,\n  synopsis AS summary,\n  recency_rank,\n  category_rank\nFROM ranked\nWHERE category_rank <= 10\nORDER BY \"publishedDate\"::timestamp DESC, id\nLIMIT 10;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -1440,
        0
      ],
      "id": "3cb668d8-fc84-4118-98f0-5f3c639adb61",
