    {
      "parameters": {
        "promptType": "define",
        "text": "=Patient diagnosis report:\n{{ $('PatientPrompt') }}\n\nFocus only on small-scale DXA and bone-density numbers (femoral neck BMD, total femur/spine BMD, L1-L4, trochanter, intertrochanteric, T-score). Return a compact findings list with 4 sections: Key numeric signals, WHO-threshold interpretation, Missing/uncertain DXA values, Preliminary bone-status lean.",
        "messages": {
          "messageValues": [
            {
              "message": "You are a bone-imaging quantitative reviewer. Stay strictly on DXA numeric evidence."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        192,
        32
      ],
      "name": "Micro DXA Metrics Review",
      "id": "74ad3a1e-5238-42fb-b536-eae4460fedd5",
      "typeVersion": 1.9,
      "notes": "{\"op-type\":\"text-generation\"}"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Patient diagnosis report:\n{{ $('PatientPrompt') }}\n\nFocus only on small-scale clinical risk numbers/flags (age, sex, BMI, fracture history, comorbidities, activity, sleep, calcium/renal/endocrine labs). Return a compact findings list with 4 sections: Risk-enhancing factors, Risk-reducing factors, Data gaps, Preliminary risk lean.",
        "messages": {
          "messageValues": [
            {
              "message": "You are a clinical risk factor reviewer for osteoporosis. Use only explicit report evidence."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        192,
        192
      ],
      "name": "Micro Clinical Risk Review",
      "id": "c7b07cfd-1aae-44d5-bdc7-c8cc69433720",
      "typeVersion": 1.9,
      "notes": "{\"op-type\":\"text-generation\"}"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Aggregate the first-level analyses for bone-density adjudication.\n\nDXA micro findings:\n{{ $('Micro DXA Metrics Review') }}\n\nClinical micro findings:\n{{ $('Micro Clinical Risk Review') }}\n\nPatient diagnosis report:\n{{ $('PatientPrompt') }}\n\nProduce: strongest evidence for osteoporosis, strongest counter-evidence, and confidence limits.",
        "messages": {
          "messageValues": [
            {
              "message": "You are the second-level bone density specialist aggregating lower-level numeric analyses."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        544,
        -240
      ],
      "name": "Bone Density Specialist",
      "id": "6aa3a05d-2502-4a69-aae5-9e4809aae512",
      "typeVersion": 1.9,
      "notes": "{\"op-type\":\"text-generation\"}"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Aggregate first-level analyses for demographic and fracture-risk interpretation.\n\nDXA micro findings:\n{{ $('Micro DXA Metrics Review') }}\n\nClinical micro findings:\n{{ $('Micro Clinical Risk Review') }}\n\nPatient diagnosis report:\n{{ $('PatientPrompt') }}\n\nProduce: major risk factors, protective factors, and uncertainty boundaries.",
        "messages": {
          "messageValues": [
            {
              "message": "You are the second-level risk specialist integrating micro-level signals."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
