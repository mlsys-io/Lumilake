        -96
      ],
      "name": "Risk Factor Specialist",
      "id": "c47349c5-38ef-443a-b81a-112ac386aee4",
      "typeVersion": 1.9,
      "notes": "{\"op-type\":\"text-generation\"}"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Aggregate first-level analyses for secondary osteoporosis contributors.\n\nDXA micro findings:\n{{ $('Micro DXA Metrics Review') }}\n\nClinical micro findings:\n{{ $('Micro Clinical Risk Review') }}\n\nPatient diagnosis report:\n{{ $('PatientPrompt') }}\n\nProduce: comorbidity/lab interpretation and impact on osteoporosis likelihood.",
        "messages": {
