    {
      "parameters": {
        "promptType": "define",
        "text": "=Map task 1 (events and timeline): Analyze the image as a news artifact and extract only concrete, directly supported facts.\n\nWrite:\n- 1 compact overview paragraph (2-3 sentences)\n- 5-7 bullets: confirmed events, entities, and timing clues\n- 2 bullets: key unknowns or missing evidence",
        "messages": {
          "messageValues": [
            {
              "message": "You are Mapper 1 in a map-reduce pipeline. Prioritize verifiable facts and timeline reconstruction, and avoid speculation."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        -64,
        -128
      ],
      "name": "Drafter 1",
      "id": "a4b49045-6c2b-4fd2-8e98-5c44067a97b0",
