      "notes": "{\n  \"op-type\": \"image-understanding\",\n  \"is-output\": false,\n  \"image-input\": \"{{ $('Image') }}\"\n}"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Audit Map 1 output for evidence quality and coverage.\n\nMap 1 Draft:\n{{ $('Drafter 1') }}\n\nReturn:\n- 5-7 bullets tagged [supported|weak|missing]\n- top 3 must-fix factual gaps",
        "messages": {
          "messageValues": [
            {
              "message": "You are Critic A for a mapper branch. Be strict about factual grounding and missing hard evidence."
            }
          ]
        },
        "batching": {}
