# Lumilake server env template.
#
# Copy to ``.env`` (run ``lumilake deploy init``) and edit. The packaged
# compose file consumes this via ``env_file: .env``; local runs load it via
# ``load_dotenv(".env")``.
#
# Run ``lumilake deploy doctor`` after editing to validate.

# ── Server ────────────────────────────────────────────────────────────────────
LUMILAKE_LOG_LEVEL="INFO"            # Log verbosity: DEBUG, INFO, WARNING, ERROR
LUMILAKE_SERVER_HOST="0.0.0.0"       # Bind address for the FastAPI server
LUMILAKE_SERVER_PORT="9000"          # Bind port for the FastAPI server
# Set to 1 to skip the .env-file-existence check at startup (useful when
# env vars are injected directly, e.g. Docker / Kubernetes).
# LUMILAKE_SKIP_DOTENV_CHECK=""

# ── Optimizer / scheduler ─────────────────────────────────────────────────────
# Default optimizer when a request omits its own ``optimizer`` field. Must
# resolve to a ``BaseOptimizer`` registered in ``OPTIMIZER_TYPES`` (built-in
# or plugin-registered). Types advertised only via an ``OptimizerProvider``
# are per-job only.
LUMILAKE_DEFAULT_OPTIMIZER="halo"
# Job manager implementation. Only "priority" is supported.
# LUMILAKE_JOB_MANAGER_TYPE="priority"
# Runtime manager implementation. "default" or "flowmesh".
# LUMILAKE_RUNTIME_MANAGER_TYPE="default"
LUMILAKE_OPTIMIZER_BATCH_SIZE="10"
LUMILAKE_STARVATION_LIMIT="3"
LUMILAKE_BATCH_ACCUMULATION_SECONDS="0"
LUMILAKE_OPTIMIZER_SUBPROCESS_TIMEOUT_SECONDS="60"
LUMILAKE_CPU_WORKER_GROUP_SIZE="1"
LUMILAKE_GPU_WORKER_GROUP_SIZE="1"
# GPU devices Lumilake assigns to FlowMesh workers, one worker per
# device. Distinct from ``.env.flowmesh``'s ``CUDA_VISIBLE_DEVICES``,
# which scopes what the FlowMesh server container itself sees. Set to a
# specific index (e.g. "0") or a comma-separated subset ("0,2") for the
# free GPUs on your host; "all" expands to every nvidia-smi-detected
# GPU. Leave blank to skip GPU worker creation.
LUMILAKE_GPU_DEVICES=""

# ── Remote optimizer (plugin-only) ────────────────────────────────────────────
# URL of an external schedule-protocol service.
# Leave blank unless a plugin registers ``RemoteOptimizer`` via an OptimizerProvider.
# LUMILAKE_REMOTE_OPTIMIZER_URL=""

# ── Plugins ──────────────────────────────────────────────────────────────────
# Comma-separated module names the server imports on startup. Each name
# must resolve to a ``*.py`` placed inside ``LUMILAKE_PLUGIN_DIR``
# (compose bind-mounts that directory at ``/app/plugins`` and adds it to
# PYTHONPATH). Leave blank to disable plugin loading.
# LUMILAKE_PLUGINS=""
# LUMILAKE_PLUGIN_DIR="./plugins"

# ── Runtime (FlowMesh) ────────────────────────────────────────────────────────
# The orchestrator URL the server dispatches workflows to. When using the
# bundled FlowMesh stack (``lumilake deploy init --flowmesh``), this is
# the http://127.0.0.1:<flowmesh.server_port> from ``.env.flowmesh``.
LUMILAKE_RUNTIME_ORCHESTRATOR_URL="http://127.0.0.1:18000"

# Server-to-server credential for FlowMesh control-plane reads (worker
# enumeration, profile fetches for dispatch planning). Per-user bearers
# carry billable work (tasks, workflows); this token carries the
# scheduler's own identity. Leave empty for local deploys where FlowMesh
# accepts unauthenticated control-plane reads. In cloud, set to a token
# whose FlowMesh principal can read worker metadata.
LUMILAKE_RUNTIME_TOKEN=""

# When set, requests are rejected with 503 unless at least one
# IdentityProvider plugin is registered. Recommended for cloud deploys —
# stops a misconfigured server from silently treating every caller as
# the default admin principal. Leave unset for local deploys.
LUMILAKE_REQUIRE_IDENTITY_PROVIDER=""

# Set to "0" in HA / multi-instance deploys so a starting standby does
# not mark live jobs (still running on the active instance) as failed.
# Default ("1") is correct for single-instance deploys.
LUMILAKE_RECOVER_IN_FLIGHT_JOBS=""

# Worker output delivery: "local" or "http". Both work identically for
# Lumilake-emitted upstream paths.
LUMILAKE_FLOWMESH_OUTPUT_DESTINATION="local"

# ── TLS / worker config (optional) ───────────────────────────────────────────
# Directory containing Redis TLS certificates (ca.crt, client.crt, client.key).
# Leave empty when Redis is not TLS-enabled.
# REDIS_TLS_DIR=""
# Directory containing server TLS certificates. Leave empty for plain HTTP.
# SERVER_TLS_DIR=""
# Path to a YAML worker config file passed to the server at startup.
# Leave empty to use built-in defaults.
# SERVER_WORKER_CONFIG=""

# ── Data plane (lumid.data) ──────────────────────────────────────────────────
# All data access routes through lumid-data-app. LUMID_DATA_URL is required
# for any deployment that runs workflows containing DataRetrievalOps or has
# data profiling enabled. LUMID_DATA_TOKEN defaults to LUMILAKE_RUNTIME_TOKEN
# above (most deploys share one lum.id PAT for FlowMesh + lumid-data-app);
# set LUMID_DATA_TOKEN explicitly only when the two need different
# credentials — e.g. FlowMesh is unauthenticated locally but lumid-data-app
# requires a PAT.
LUMID_DATA_URL="http://127.0.0.1:9102"
# LUMID_DATA_TOKEN=""
# LUMID_DATA_TIMEOUT_SECONDS="30"

# Logical blob-key prefix in lumid-data-app's store for compute data
# (workflow inputs/outputs). Used as the base key prefix for S3-input
# resolution and output writes. Required when any workflow uses S3 inputs
# or outputs.
S3_DATA_PREFIX="lumilake-demo"

# Logical blob-key prefix in lumid-data-app's store for job records and
# runtime artifacts (the archive layer).
S3_ARCHIVE_PREFIX="lumilake-archive/artifacts"

# ── Tuning (optional) ─────────────────────────────────────────────────────────
# LUMILAKE_POLL_TIMEOUT_SECONDS=""       # Total time the CLI polls for job completion (unset = forever)
# LUMILAKE_POLL_INTERVAL_SECONDS="5"    # Seconds between job-status polls
# LUMILAKE_HTTP_TIMEOUT_SECONDS="300"   # HTTP timeout for SDK/CLI calls to the server
# LUMILAKE_QUEUE_QUANTUM_HIGH="20"      # Max scheduling quanta per cycle for high-priority jobs
# LUMILAKE_QUEUE_QUANTUM_MEDIUM="10"    # Max scheduling quanta per cycle for medium-priority jobs
# LUMILAKE_QUEUE_QUANTUM_LOW="5"        # Max scheduling quanta per cycle for low-priority jobs
# LUMILAKE_DATA_PROFILE_NUM_TEST_QUERIES="1"    # Number of test queries run during data profiling
# LUMILAKE_S3_PROFILE_COST_PER_FILE="0.05"      # Estimated cost weight per file in S3 profiling
# LUMILAKE_S3_PROFILE_COST_PER_MIB="0.01"       # Estimated cost weight per MiB in S3 profiling
# LUMILAKE_LOCAL_DATA_PROFILE_PLAN_VARIANTS="default,prefer_index,prefer_seq,prefer_nestloop"
#                                                # Plan variants sent to lumid-data-app /profile
# LUMILAKE_DISABLE_DATA_PROFILE=""              # Set to "1" to skip data profiling entirely
# LUMILAKE_DATA_PROFILE_ENABLE_LIVE_SAMPLING="" # Set to "1" to enable live row sampling during profiling
# LUMILAKE_LOG_DOWNLOAD_SPOOL_MAX_MB="16"       # Max MB buffered when streaming job logs

# ── vLLM runtime (optional) ───────────────────────────────────────────────────
# Passed through to vLLM-based workers. Only needed when running vLLM
# inference workers under Lumilake.
# LUMILAKE_VLLM_MAX_NUM_BATCHED_TOKENS="2048"      # Max tokens per vLLM batch
# LUMILAKE_VLLM_MAX_CUDAGRAPH_CAPTURE_SIZE="64"    # Max batch size for CUDA graph capture in vLLM
# LUMILAKE_VLLM_GPU_MEMORY_UTILIZATION="0.9"       # Fraction of GPU memory vLLM may use (0.0–1.0)

# ── Hardware requirements (optional) ──────────────────────────────────────────
# Default resource requirements applied to workers that don't declare their own.
# Per-job overrides (lumilake job submit --cpu/--memory/--gpu/--gpu-memory or POST /jobs hardware{}) fall back to these when a field is unset.
# HARDWARE_CPU_REQUIREMENT="8"           # CPU cores required per worker
# HARDWARE_MEMORY_REQUIREMENT="16Gi"     # RAM required per worker
# HARDWARE_GPU_REQUIREMENT="1"           # GPUs required per worker
# HARDWARE_GPU_MEMORY_REQUIREMENT="8Gi"  # GPU VRAM required per worker

# ── Docker ───────────────────────────────────────────────────────────────────
# `dev` is the rolling main image. Pin to `vX.Y.Z` for production.
LUMILAKE_IMAGE_TAG="dev"
# Trust-bearing override of the server-image registry (see docs/ENV.md).
# LUMILAKE_REGISTRY="ghcr.io/mlsys-io"
