LUMILAKE_LOG_LEVEL="<optional>"

LUMILAKE_JOB_MANAGER_TYPE="<optional:priority>"
LUMILAKE_RUNTIME_MANAGER_TYPE="<optional:default|flowmesh>"
LUMILAKE_OPTIMIZER_BATCH_SIZE="<optional:int>"
LUMILAKE_STARVATION_LIMIT="<optional:int>=0 (misses before starvation override)>"
LUMILAKE_BATCH_ACCUMULATION_SECONDS="<optional:float>=0 (wait window before batch optimization/scheduling)>"
LUMILAKE_CPU_WORKER_GROUP_SIZE="<optional:int>=0"
LUMILAKE_GPU_WORKER_GROUP_SIZE="<optional:int>=0"

LUMILAKE_SERVER_HOST="<required>"
LUMILAKE_SERVER_PORT="<required>"

LUMILAKE_POLL_TIMEOUT_SECONDS="<optional:float>"
LUMILAKE_POLL_INTERVAL_SECONDS="<optional:float>"
LUMILAKE_OPTIMIZER_SUBPROCESS_TIMEOUT_SECONDS="<optional:float> default 60"
LUMILAKE_DATA_PROFILE_NUM_TEST_QUERIES="<optional:int (max SQL statements executed per SQL runtime node during profiling)>"
LUMILAKE_S3_PROFILE_COST_PER_FILE="<optional:float (S3 retrieval cost per file)>"
LUMILAKE_S3_PROFILE_COST_PER_MIB="<optional:float (S3 retrieval cost per MiB)>"
LUMILAKE_HTTP_TIMEOUT_SECONDS="<optional:float>"

LUMILAKE_RUNTIME_ORCHESTRATOR_URL="<required>"
LUMILAKE_RUNTIME_TOKEN="<optional>"

LUMID_DATA_URL="<optional:http://host:port>"
LUMID_DATA_TOKEN="<optional>"
LUMID_DATA_TIMEOUT_SECONDS="<optional:float>"

# Direct mode only. Optional when LUMID_DATA_URL is set.
DATABASE_URL="<optional:compute db dsn>"
S3_URL="<optional:s3://access:secret@endpoint/bucket[/prefix]>"
S3_CERT_FILE="<optional>"
S3_USER_DATA_PREFIX="<optional:bucket/prefix>"

# Job records/artifacts archive prefix.
S3_ARCHIVE_PREFIX="<required archive prefix:bucket/prefix>"

HARDWARE_CPU_REQUIREMENT="<optional:int>"
HARDWARE_MEMORY_REQUIREMENT="<optional:16Gi>"
HARDWARE_GPU_REQUIREMENT="<optional:int>"
HARDWARE_GPU_MEMORY_REQUIREMENT="<optional:8Gi>"

LUMILAKE_IMAGE_TAG="<optional:latest>"
